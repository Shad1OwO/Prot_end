# Local development only. Leave NODE_ENV unset (or "production") on any real deployment:
# production refuses to start with the placeholder secrets below or without DATABASE_URL.
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
DATABASE_URL=postgres://tourism:tourism@localhost:5432/tourism
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=replace-with-a-random-redis-password
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_API_KEY=replace-with-a-random-internal-key
# Header your reverse proxy writes the client address into: cf-connecting-ip (Cloudflare Tunnel, or any
# origin that accepts traffic from Cloudflare alone) or x-forwarded-for (Caddy, nginx). Leave empty without
# a proxy. compose.yaml sets cf-connecting-ip for the bundled tunnel.
# CLIENT_IP_HEADER=cf-connecting-ip
# Token of the Cloudflare Tunnel that compose.yaml's cloudflared service runs (Zero Trust > Networks > Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=
# Sign-in/registration attempts allowed per client per minute.
# AUTH_RATE_LIMIT_MAX=10
# Optional: require "Authorization: Bearer <token>" on /metrics.
# METRICS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER_PRIORITY=gemini
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tourism-media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=replace-me
S3_FORCE_PATH_STYLE=true

MEDIA_CLAMAV_HOST=clamav
MEDIA_CLAMAV_PORT=3310
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
HISTORY_RETENTION_DAYS=90
