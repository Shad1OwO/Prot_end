{
  "name": "@tourism/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./seed-data": "./src/seed-data.ts",
    "./catalog-import/writer": "./src/catalog-import/writer.ts",
    "./seed-catalog": "./src/seed-catalog.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate",
